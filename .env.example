# Copia este archivo como .env.local para probar pagos en local, o define las variables en
# Vercel → Settings → Environment Variables. Nunca subas claves reales al repositorio.

# Clave secreta para cifrar los identificadores que guarda el servidor. Cualquier texto largo
# y aleatorio (por ejemplo, el resultado de: openssl rand -base64 32). No la cambies después.
WRAPPSAPP_SECRET=

# Stripe → Developers → API keys. Usa la de prueba (sk_test_...) hasta que todo funcione.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → el endpoint de /api/stripe-webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (Vercel → Storage → Upstash → Connect): se rellenan solas al conectarla.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: dirección pública si usas dominio propio (para volver de la página de pago).
PUBLIC_SITE_URL=
